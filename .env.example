# Copy to .env. JSON arrays contain QQ IDs as strings. Empty lists disable access.
ARK_ADMIN_QQ=[]
ARK_ALLOWED_GROUPS=[]
ARK_HOST=127.0.0.1
ARK_PORT=8080
# Required for starting the bot; set the same token in NapCat's reverse WS client.
ARK_ONEBOT_TOKEN=
ARK_DATA_DIR=data
# Optional. Auto-detect Microsoft YaHei / SimHei on Windows or Noto Sans CJK on Linux.
ARK_FONT_PATH=
